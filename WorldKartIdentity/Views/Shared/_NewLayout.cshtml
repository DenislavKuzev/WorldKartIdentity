    <nav class="bg-transparent absolute top-0 left-0 right-0 z-50">
        <div class="container mx-auto flex items-center justify-between py-4 px-6">
            <a asp-action="Index" asp-controller="Home" class="text-red-600 font-bold uppercase text-lg">Световна Картинг Арена</a>

            <div class="flex items-center space-x-4">
                <button class="text-white focus:outline-none md:hidden" id="navbar-toggler" aria-expanded="false" aria-controls="navbarNav" aria-label="Toggle navigation">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
                    </svg>
                </button>

                <div id="navbarNav" class="hidden md:flex md:items-center md:space-x-6">
                    <a asp-action="Index" asp-controller="Home" class="text-white hover:text-red-600 transition duration-300">Начална страница</a>
                    <a asp-action="AboutUs" asp-controller="Home" class="text-white hover:text-red-600 transition duration-300">За нас</a>

                    @if (User?.IsInRole("Admin") == true)
                    {
                        <a asp-action="Admin" asp-controller="Admin" class="text-white hover:text-red-600 transition duration-300">Админ панел</a>
                    }

                    <a asp-action="TrackGallery" asp-controller="Track" class="text-white hover:text-red-600 transition duration-300">Картинг галерия</a>

                    @if (User?.IsInRole("Users") == true)
                    {
                        <a asp-action="TrackRequest" asp-controller="Track" class="text-white hover:text-red-600 transition duration-300">Заяви писта</a>
                        <a asp-action="Blogs" asp-controller="Blog" class="text-white hover:text-red-600 transition duration-300">Блог</a>
                    }

                    @if (!(User?.Identity?.IsAuthenticated ?? false))
                    {
                        <a asp-action="Login" asp-controller="User" class="text-red-600 font-bold hover:text-white transition duration-300">Вход</a>
                    }

                    @if (User?.IsInRole("Users") == true)
                    {
                        <a asp-action="UserProfile" asp-controller="User" class="text-white fa fa-user" aria-hidden="true" title="Профил"></a>
                        @* <a asp-action="Notifications" asp-controller="User" class="text-white fa fa-bell" aria-hidden="true" title="Известия"></a> *@
                    }
                </div>
            </div>
        </div>
    </nav>
    @RenderBody()
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/viewerjs/1.11.7/viewer.min.js" integrity="sha512-lZD0JiwhtP4UkFD1mc96NiTZ14L7MjyX5Khk8PMxJszXMLvu7kjq1sp4bb0tcL6MY+/4sIuiUxubOqoueHrW4w==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
