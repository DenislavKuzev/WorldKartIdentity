                    <div class="ts_text">
                        <h4>Added by: @trajectory.User.UserName</h4>
                        
                    </div>
                </div>
             </a>
            }

           
           
        </div>
    </div>
</section>

<section class="contact-section spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-sm-6">
                <div class="section-title contact-title">
                    <span>Данни на пистата</span>
                    <h2>СВЪРЗВАНЕ</h2>
                </div>
