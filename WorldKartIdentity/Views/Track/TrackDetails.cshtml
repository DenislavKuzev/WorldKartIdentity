@using System.Text.Json
@model WorldKartIdentity.ViewModel.TrackViewModel

@{
    ViewData["Title"] = "Детайли за писта";
    Layout = "~/Views/Shared/_NewLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/trackdetails.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/pintura/pintura.css" />
    <link rel="stylesheet" href="~/lib/node_modules/@@recogito/annotorious/dist/annotorious.min.css" />
}

<main class="pt-24 pb-12 px-4 md:px-8 max-w-7xl mx-auto">
    <!-- Back Button -->
    <div class="mb-8">
        <button class="group flex items-center gap-2 text-outline hover:text-primary transition-colors">
            <span
                class="material-symbols-outlined transition-transform group-hover:-translate-x-1">arrow_back</span>
            <a asp-action="TrackGallery" asp-controller="Track" class="font-headline font-bold uppercase tracking-tighter text-sm">НАЗАД</a>
        </button>
    </div>

    <!-- Hero Title Section -->
    <div class="mb-12">
        <h1 class="font-headline text-5xl md:text-7xl font-black italic tracking-tighter text-on-surface mb-2">
            @Model.Name.ToUpper()
        </h1>
        <div class="flex items-center gap-4 text-secondary font-medium">
            <span class="flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">location_on</span>
                @Model.Location
            </span>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Left Column: Image & Description -->
        <div class="lg:col-span-8 space-y-6">
            <!-- Main Track Feature Card -->
            <div class="relative h-[450px] rounded-xl overflow-hidden group">
                <img alt="широк кинематографичен кадър на професионална асфалтова картинг писта"
                     class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                     src="data:image/png;base64,@Model.PhotographBase64" />
                <div
                    class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent opacity-80">
                </div>
                <div class="absolute bottom-0 left-0 p-8">
                    <p class="max-w-xl text-lg text-on-surface/90 leading-relaxed font-body">
                        @Model.Description
                    </p>
                </div>
            </div>

            <!-- Technical Specs -->
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                <div
                    class="bg-surface-container-low p-6 rounded-xl hover:bg-surface-container-high transition-colors">
                    <span class="material-symbols-outlined text-primary-container mb-2 text-xl">straighten</span>
                    <div class="text-outline text-[10px] font-bold uppercase tracking-widest mb-1">
                        Дължина на пистата
                    </div>
                    <div class="font-headline text-2xl font-black">
                        @Model.Length<span class="text-sm font-normal ml-1 text-outline">м</span>
                    </div>
                </div>

                <div
                    class="bg-surface-container-low p-6 rounded-xl hover:bg-surface-container-high transition-colors">
                    <span
                        class="material-symbols-outlined text-primary-container mb-2 text-xl">turn_slight_right</span>
                    <div class="text-outline text-[10px] font-bold uppercase tracking-widest mb-1">
                        Общо завои
                    </div>
                    <div class="font-headline text-2xl font-black">@Model.TurnCount</div>
                </div>

                <div
                    class="bg-surface-container-low p-6 rounded-xl hover:bg-surface-container-high transition-colors">
                    <span class="material-symbols-outlined text-primary-container mb-2 text-xl">width</span>
                    <div class="text-outline text-[10px] font-bold uppercase tracking-widest mb-1">
                        Ширина
                    </div>
                    <div class="font-headline text-2xl font-black">
                        @Model.Width<span class="text-sm font-normal ml-1 text-outline">м</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Info & Contact Card -->
        <div class="lg:col-span-4 space-y-6">
            <div class="bg-surface-container-high p-8 rounded-xl flex flex-col gap-8">
                <div>
                    <h3 class="font-headline font-black uppercase tracking-tighter mb-6 italic">
                        КОНТАКТИ И ИНФОРМАЦИЯ
                    </h3>

                    <div class="space-y-6">
                        <div class="flex gap-4">
                            <span class="material-symbols-outlined text-primary-container">pin_drop</span>
                            <div>
                                <div class="text-[10px] font-bold text-outline uppercase tracking-widest mb-1">
                                    Адрес
                                </div>
                                <div class="text-sm font-medium">@Model.Location</div>
                            </div>
                        </div>

                        <div class="flex gap-4">
                            <span class="material-symbols-outlined text-primary-container">call</span>
                            <div>
                                <div class="text-[10px] font-bold text-outline uppercase tracking-widest mb-1">
                                    Телефон
                                </div>
                                <div class="text-sm font-medium">@Model.TelNumber</div>
                            </div>
                        </div>

                        <div class="flex gap-4">
                            <span class="material-symbols-outlined text-primary-container">mail</span>
                            <div>
                                <div class="text-[10px] font-bold text-outline uppercase tracking-widest mb-1">
                                    Имейл
                                </div>
                                <div class="text-sm font-medium">@Model.Email</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="pt-6 border-t border-outline-variant/30 flex items-center justify-between">
                    <div>
                        <div class="text-[10px] font-bold text-outline uppercase tracking-widest mb-1">
                            Статус
                        </div>
                        <div class="flex items-center gap-2">
                            <span id="statusDot" class="w-2 h-2 rounded-full bg-tertiary"></span>
                            <span id="statusText" class="text-sm font-bold font-headline uppercase tracking-tight">
                                ОТВОРЕНО СЕГА
                            </span>
                        </div>
                    </div>

                    <div class="text-right">
                        <div id="countdownLabel" class="text-[10px] font-bold text-outline uppercase tracking-widest mb-1">
                            Затваря след
                        </div>
                        <div id="countdown" class="text-sm font-bold font-headline">--:--</div>
                    </div>
                </div>
            </div>
            <div
                class="bg-surface-container-high p-8 rounded-xl flex flex-col gap-6 border-t-2 border-primary-container/20 relative mt-6 h-64">
                <div class="flex items-center justify-center h-full">
                   

                    <div class="flex flex-col items-center">
                        <div class="flex items-center gap-1.5 text-primary-container">
                            <span class="material-symbols-outlined text-2xl"
                                  style="font-variation-settings: 'FILL' 1;">favorite</span>
                            <span class="font-headline text-2xl font-black likes">@Model.LikesCount</span>
                        </div>
                        <span class="text-[8px] font-bold text-outline uppercase tracking-widest">
                            Общо харесвания
                        </span>
                    </div>
                </div>
                @if (User.Identity.IsAuthenticated)
                {
                    @if (Model.IsLikedByCurrentUser)
                    {
                       <button
                    class="w-full flex items-center justify-center gap-2 py-3 bg-rose-600 hover:bg-primary-container transition-all group rounded-lg">
                    <span
                        class="material-symbols-outlined like-icon text-white group-hover:text-white transition-colors">favorite</span>
                        </button>
                    }
                    else
                    {
                         <button
                    class="w-full flex items-center justify-center gap-2 py-3 bg-surface-container-highest hover:bg-primary-container transition-all group rounded-lg">
                    <span
                        class="material-symbols-outlined like-icon text-primary-container group-hover:text-white transition-colors">favorite</span>
                        </button>
                    }

                }
                
            </div>
        </div>
    </div>

    <!-- Large Interactive Layout & AI Assistant Section -->
    <section class="mt-6 grid grid-cols-1 lg:grid-cols-12 gap-6 mh-900px">
        <!-- Large Track Layout Drawing Mode -->
        <div
            class="lg:col-span-8 bg-surface-container p-8 rounded-xl border-t-4 border-primary-container shadow-2xl relative overflow-hidden">
            <div class="flex items-center justify-between mb-8">
                <div>
                    <h3 class="font-headline font-black text-2xl uppercase tracking-tighter italic">
                        КАРТИРАНЕ НА ТРАЕКТОРИЯ
                    </h3>
                    <p class="text-[10px] font-bold text-outline uppercase tracking-widest">
                        ПЛЪЗНЕТЕ, ЗА ДА НАЧЕРТАЕТЕ ВАШАТА ИДЕАЛНА ЛИНИЯ
                    </p>
                </div>
            </div>

            <div class="drawing-canvas rounded-lg relative flex items-center justify-center">
            </div>
        </div>

        <!-- AI Assistant Panel -->
        <div class="lg:col-span-4 flex flex-col gap-6">
            <div class="bg-surface-container-high rounded-xl overflow-hidden flex flex-col h-full">
                <div class="p-6 bg-primary-container flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <span
                            class="material-symbols-outlined text-on-primary-container animate-bounce">rocket_launch</span>
                        <h3
                            class="font-headline font-black text-on-primary-container uppercase tracking-tighter italic">
                            AI <b class="ml-1">треньор</b>
                        </h3>
                    </div>
                </div>

                <div class="flex-1 p-6 space-y-4 max-h-[630px] overflow-y-auto" id="apex-chat-history">
                </div>

                <div class="px-4 py-6 bg-surface-container-lowest border-t border-outline-variant/20">
                    <div class="relative">
                        <input
                            class="w-full bg-surface-container border-none rounded-lg py-3 px-4 text-on-surface focus:ring-1 focus:ring-primary-container placeholder:text-outline/50 font-medium text-sm"
                            id="apex-chat-input"
                            placeholder="Попитай AI треньора..."
                            type="text" />
                        <button
                            class="absolute right-2 top-1.5 p-1.5 text-primary-container hover:bg-primary-container/10 rounded-md"
                            id="apex-chat-send">
                            <span class="material-symbols-outlined text-sm">send</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Community Trajectories Panel -->
    <section class="mt-12">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h3 class="font-headline font-black text-2xl uppercase tracking-tighter italic">
                    ТРАЕКТОРИИ
                </h3>
            </div>

            @* <button
                class="text-primary-container flex items-center gap-2 text-xs font-bold uppercase tracking-widest hover:underline">
                Виж всички
            </button> *@
        </div>

        <div class="flex gap-6 overflow-x-auto pb-4 no-scrollbar">
            @foreach(var traj in Model.Trajectories)
            {
                <a
                    class="flex-none w-72 bg-surface-container-low rounded-xl overflow-hidden"
                    href="@Url.Action("TrajectoryDetails", "Track", new {id = traj.Id})">
                    <div class="h-36 bg-surface-container-highest relative flex items-center justify-center">
                        <img class="w-full" src="data:image/png;base64,@traj.Base64" />
                    </div>

                    <div class="p-4 flex items-center justify-between bg-surface-container-high/50">
                        <div>
                            <div class="text-[9px] font-bold text-outline uppercase tracking-widest mt-0.5">
                                От @traj.User.UserName
                            </div>
                        </div>

                        @* <div class="flex items-center gap-1 text-primary-container">
                            <span class="material-symbols-outlined text-sm"
                                style="font-variation-settings: 'FILL' 1;">favorite</span>
                            <span class="text-xs font-black">248</span>
                        </div> *@
                    </div>
                </a>
            }
        </div>
    </section>

    <!-- Location Map Section -->
    <section class="mt-12">
        <div class="bg-surface-container-low rounded-xl overflow-hidden">
            <div class="flex items-center justify-between p-6 border-b border-outline-variant/20">
                <h3 class="font-headline font-black uppercase tracking-tighter italic">
                    ЛОКАЦИЯТА
                </h3>
            </div>

            <iframe src="@Model.GoogleMapsLink"
                    style="filter: invert(100%)"
                    class="w-full"
                    height="700"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade">
            </iframe>
        </div>
    </section>
</main>

@section Scripts {
    <script>
        window.trackContext = @Html.Raw(JsonSerializer.Serialize(new {
            trackId = Model.Id,
            trackBase64 = Model.RoutePictureBase64,
            trackWorktime = Model.Worktime
        }));
    </script>

    <script type="module" src="~/lib/pintura/pintura.js"></script>
    <script type="module" src="~/js/trackdetails.js"></script>
    <script src="~/lib/node_modules/@@recogito/annotorious/dist/annotorious.min.js"></script>
}