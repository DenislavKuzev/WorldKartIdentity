<section class="class-details-section description">
<div class="container-fluid py-3">
    <div class="container py-3">
        <div class="service-item service-item-right">
            <div class="row g-4 align-items-center">
                <div class="col-md-5 order-md-1 text-md-end">
                    <div class="service-img p-5 wow fadeInLeft" data-wow-delay="0.2s">
                            <img class="img-fluid rounded-circle" style="border-radius: 40% !important;" src="~/img/trackdescription.jpg" alt="Track Info">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="service-text px-5 px-md-5 py-md-5 fadeInLeft">
                        <h3 class="text-uppercase text-danger">Описание</h3>
                        <p class="mb-5">@Model.Description</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</section>


@if (User.Identity.IsAuthenticated == true)
{
    <section class="class-details-section spad">
        <div class="container d-flex align-items-center justify-content-center">
            <div class="row img-container d-flex w-100 h-75">
                <div class="col-lg-10 pnt-editor">
                </div>
            </div>
        </div>
    </section>
}
else
{
    <section class="class-details-section spad">
        <div class="container d-flex align-items-center justify-content-center">
            <div class="row img-container d-flex w-75 h-75">
                <image src="data:image/jpeg;base64,@Model.PictureBase64" class="w-100 h-100"></image>
            </div>
        </div>
    </section>
}

<section class="team-section team-page spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="team-title">
                    <div class="section-title">
                        <span>Траектории</span>
                        <h2>НАЙ-ХАРЕСВАНИ ТРАЕКТОРИИ</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            @foreach (var trajectory in Model.Trajectories)
            {
                
              <a class="col-lg-4 col-sm-6" asp-action="TrajectoryDetails" asp-action="TrajectoryDetails" asp-controller="Track" asp-route-id="@trajectory.Id">
                <div class="ts-item set-bg" style="background-image: url('data:image/png;base64,@trajectory.Base64');">
                    <div class="ts_text">
                        <h4>Added by: @trajectory.User.UserName</h4>
                        @* <span>Number of likes</span> *@
                    </div>
                </div>
             </a>
            }

           
           
        </div>
    </div>
</section>

<section class="contact-section spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-sm-6">
                <div class="section-title contact-title">
                    <span>Данни на пистата</span>
                    <h2>СВЪРЗВАНЕ</h2>
                </div>
                <div class="contact-widget">
                    <div class="cw-text">
                        <i class="fa fa-map-marker"></i>
                        <p>@Model.Location</p>
                    </div>
                    <div class="cw-text">
                        <i class="fa fa-mobile"></i>
                        <ul>
                            <li>@Model.TelNumber</li>
                        </ul>
                    </div>
                    <div class="cw-text email">
                        <i class="fa fa-envelope"></i>
                        <p>@Model.Email</p>
                    </div>
                    <div class="cw-text">
                        <i class="fa fa-clock-o" aria-hidden="true"></i>
                        <ul>
                            <li>@Model.Worktime</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-sm-8">
                <div class="map">
                    <iframe src="@Model.GoogleMapsLink"
                            height="450" style="border:0;" allowfullscreen="">
                    </iframe>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        window.trackContext = @Html.Raw(JsonSerializer.Serialize(new {
      trackId = Model.Id,
      trackBase64 = Model.PictureBase64   // no .ToString() needed
  }));
    </script>

    <script type="module" src="~/lib/pintura/pintura.js"></script>
    <script type="module" src="~/js/trackdetails.js"></script>
    <script src="~/lib/node_modules/@@recogito/annotorious/dist/annotorious.min.js"></script>

}