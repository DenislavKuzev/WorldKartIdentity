 <main class="pt-24 pb-12 px-4 md:px-8 max-w-7xl mx-auto">
        <!-- Back Button -->
        <div class="mb-8">
            <button class="group flex items-center gap-2 text-outline hover:text-primary transition-colors">
                <span
                    class="material-symbols-outlined transition-transform group-hover:-translate-x-1">arrow_back</span>
                <span class="font-headline font-bold uppercase tracking-tighter text-sm">BACK</span>
            </button>
        </div>
        <!-- Hero Title Section -->
        <div class="mb-12">
            <h1 class="font-headline text-5xl md:text-7xl font-black italic tracking-tighter text-on-surface mb-2">
                @Model.Name.ToUpper()
            </h1>
            <div class="flex items-center gap-4 text-secondary font-medium">
                <span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm">location_on</span>
                    @Model.Location</span>
            </div>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <!-- Left Column: Image & Description (Bento Style) -->
            <div class="lg:col-span-8 space-y-6">
                <!-- Main Track Feature Card -->
                <div class="relative h-[450px] rounded-xl overflow-hidden group">
                    <img alt="wide cinematic shot of a professional asphalt karting track"
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                        src="https://lh3.googleusercontent.com/aida-public/AB6AXuD5bwB8MjHoOP7Q-HJ2x1wSWhSL59K89PEdvFM9Wb5ljIilFSYraRNoGnEgH1E-9e4IbawGJ9BfBclNiH-F0ANv28CGdgCBC7TaQGskllVc1pu1FIl7pz0U7NwYsvq-AfX9Gcg9bWQL35oCKYEvlSPlyQKrd5MRW93JOMf9EBBVFmldvjEZo4m1oXcyGPqdVJJUaZXUfeW53VttJ-o0NIbbYVFZ8f5z8HNw12axZ0ayaqg3xL4ETu5FToxpMiFMjCgPKZN-JAVJ_jLw" />
                    <div
                        class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent opacity-80">
                    </div>
                    <div class="absolute bottom-0 left-0 p-8">
                        <p class="max-w-xl text-lg text-on-surface/90 leading-relaxed font-body">
                           @Model.Description
                        </p>
                    </div>
                </div>
                <!-- Technical Specs & Weather -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div
                        class="bg-surface-container-low p-6 rounded-xl hover:bg-surface-container-high transition-colors">
                        <span class="material-symbols-outlined text-primary-container mb-2 text-xl">straighten</span>
                        <div class="text-outline text-[10px] font-bold uppercase tracking-widest mb-1">Track Length
                        </div>
                        <div class="font-headline text-2xl font-black">1050<span
                                class="text-sm font-normal ml-1 text-outline">M</span></div>
                    </div>
                    <div
                        class="bg-surface-container-low p-6 rounded-xl hover:bg-surface-container-high transition-colors">
                        <span
                            class="material-symbols-outlined text-primary-container mb-2 text-xl">turn_slight_right</span>
                        <div class="text-outline text-[10px] font-bold uppercase tracking-widest mb-1">Total Turns</div>
                        <div class="font-headline text-2xl font-black">13</div>
                    </div>
                    <div
                        class="bg-surface-container-low p-6 rounded-xl hover:bg-surface-container-high transition-colors">
                        <span class="material-symbols-outlined text-primary-container mb-2 text-xl">width</span>
                        <div class="text-outline text-[10px] font-bold uppercase tracking-widest mb-1">Width</div>
                        <div class="font-headline text-2xl font-black">8<span
                                class="text-sm font-normal ml-1 text-outline">M</span></div>
                    </div>
                    <div
                        class="bg-surface-container-low p-6 rounded-xl hover:bg-surface-container-high transition-colors">
                        <span class="material-symbols-outlined text-primary-container mb-2 text-xl">speed</span>
                        <div class="text-outline text-[10px] font-bold uppercase tracking-widest mb-1">Max Speed</div>
                        <div class="font-headline text-2xl font-black">115<span
                                class="text-sm font-normal ml-1 text-outline">KM/H</span></div>
                    </div>
                </div>
            </div>
            <!-- Right Column: Info & Contact Card -->
            <div class="lg:col-span-4 space-y-6">
                <div class="bg-surface-container-high p-8 rounded-xl flex flex-col gap-8">
                    <div>
                        <h3 class="font-headline font-black uppercase tracking-tighter mb-6 italic">CONTACT &amp; INFO
                        </h3>
                        <div class="space-y-6">
                            <div class="flex gap-4">
                                <span class="material-symbols-outlined text-primary-container">pin_drop</span>
                                <div>
                                    <div class="text-[10px] font-bold text-outline uppercase tracking-widest mb-1">
                                        Address</div>
                                    <div class="text-sm font-medium">гр.Кюстендил ,ул. „Студен кладенец“ 22</div>
                                </div>
                            </div>
                            <div class="flex gap-4">
                                <span class="material-symbols-outlined text-primary-container">call</span>
                                <div>
                                    <div class="text-[10px] font-bold text-outline uppercase tracking-widest mb-1">Phone
                                    </div>
                                    <div class="text-sm font-medium">0896 807 806</div>
                                </div>
                            </div>
                            <div class="flex gap-4">
                                <span class="material-symbols-outlined text-primary-container">mail</span>
                                <div>
                                    <div class="text-[10px] font-bold text-outline uppercase tracking-widest mb-1">Email
                                    </div>
                                    <div class="text-sm font-medium">pautaliatrack@email.com</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="pt-6 border-t border-outline-variant/30 flex items-center justify-between">
                        <div>
                            <div class="text-[10px] font-bold text-outline uppercase tracking-widest mb-1">Status</div>
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-tertiary"></span>
                                <span class="text-sm font-bold font-headline uppercase tracking-tight">OPEN NOW</span>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-[10px] font-bold text-outline uppercase tracking-widest mb-1">Closes In
                            </div>
                            <div class="text-sm font-bold font-headline">04:22:15</div>
                        </div>
                    </div>
                </div>
                <div
                    class="bg-surface-container-high p-8 rounded-xl flex flex-col gap-6 border-t-2 border-primary-container/20 mt-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <h3 class="font-headline font-black uppercase tracking-tighter italic">TRACK POPULARITY</h3>
                            <p class="text-[10px] font-bold text-outline uppercase tracking-widest mt-1">Community
                                Rating</p>
                        </div>
                        <div class="flex flex-col items-end">
                            <div class="flex items-center gap-1.5 text-primary-container">
                                <span class="material-symbols-outlined text-2xl"
                                    style="font-variation-settings: 'FILL' 1;">favorite</span>
                                <span class="font-headline text-2xl font-black">1,248</span>
                            </div>
                            <span class="text-[8px] font-bold text-outline uppercase tracking-widest">Total Likes</span>
                        </div>
                    </div>
                    <button
                        class="w-full flex items-center justify-center gap-2 py-3 bg-surface-container-highest hover:bg-primary-container transition-all group rounded-lg border border-outline-variant/30">
                        <span
                            class="material-symbols-outlined text-primary-container group-hover:text-on-primary-container transition-colors">favorite</span>
                        <span
                            class="font-headline font-bold uppercase tracking-widest text-xs group-hover:text-on-primary-container">Like
                            Track</span>
                    </button>
                </div>
            </div>
        </div>
        <!-- Large Interactive Layout & AI Assistant Section -->
        <section class="mt-6 grid grid-cols-1 lg:grid-cols-12 gap-6 mh-900px">
            <!-- Large Track Layout (Drawing Mode) -->
            <div
                class="lg:col-span-8 bg-surface-container p-8 rounded-xl border-t-4 border-primary-container shadow-2xl relative overflow-hidden">
                <div class="flex items-center justify-between mb-8">
                    <div>
                        <h3 class="font-headline font-black text-2xl uppercase tracking-tighter italic">TRAJECTORY
                            MAPPING</h3>
                        <p class="text-[10px] font-bold text-outline uppercase tracking-widest">DRAG TO DRAW YOUR IDEAL
                            LINE</p>
                    </div>
                    <div class="flex items-center gap-4">
                        <button
                            class="flex items-center gap-2 px-3 py-1.5 bg-surface-container-high rounded-lg text-xs font-bold uppercase tracking-widest text-outline hover:text-on-surface border border-outline-variant/30 transition-all">
                            <span class="material-symbols-outlined text-sm">edit</span> DRAW
                        </button>
                        <button
                            class="flex items-center gap-2 px-3 py-1.5 bg-surface-container-high rounded-lg text-xs font-bold uppercase tracking-widest text-outline hover:text-on-surface border border-outline-variant/30 transition-all">
                            <span class="material-symbols-outlined text-sm">delete</span> CLEAR
                        </button>
                    </div>
                </div>
                <div
                    class="drawing-canvas rounded-lg relative flex items-center justify-center">
                    <!-- Abstract Track Representation SVG -->
                    @* <img alt="Track Layout Schematic" class="w-full h-full object-contain drop-shadow-[0_0_30px_rgba(225,29,72,0.1)]" src="https://lh3.googleusercontent.com/aida/ADBb0uheRK8oGNdw8edjbikxejHcP_7Lb0EAhxPf-q_j9Lzv67nbUn0pEJ--ixm7T5zFfkLsvSsgi1EuiRBgDz6l8QLmjnQaSwEmjJEiiAwCBtOARscCBtmza4ZC8utcSw3HWmvglKC2FT7Kxc9z3jEhYjZj9k8QETbjY4PUWtBreZDPaGgb5uLOc_9_Mff89MLchvvbVyWjoDFBp-72Fq1lC_fT8_-MtiBMoecf3HkoXFeLc5RzI02VttJjv6-gcS9twTugt_Qpz1jZwLc"/> *@
                </div>
                <div class="mt-6 flex gap-6 overflow-x-auto pb-2 no-scrollbar">
                    <div class="flex-none flex items-center gap-2 text-xs">
                        <span
                            class="w-3 h-3 rounded-full bg-primary-container shadow-[0_0_8px_rgba(225,29,72,0.5)]"></span>
                        <span class="text-outline font-bold uppercase tracking-widest">Ideal Line</span>
                    </div>
                    <div class="flex-none flex items-center gap-2 text-xs">
                        <span class="w-3 h-3 rounded-full bg-tertiary shadow-[0_0_8px_rgba(116,216,189,0.5)]"></span>
                        <span class="text-outline font-bold uppercase tracking-widest">Your Trajectory</span>
                    </div>
                    <div class="flex-none flex items-center gap-2 text-xs">
                        <span class="w-3 h-3 rounded-full bg-slate-700"></span>
                        <span class="text-outline font-bold uppercase tracking-widest">Track Limits</span>
                    </div>
                </div>
            </div>
            <!-- AI ASSISTANT PANEL -->
            <div class="lg:col-span-4 flex flex-col gap-6">
                <div
                    class="bg-surface-container-high rounded-xl overflow-hidden flex flex-col h-full border border-primary-container/10">
                    <div class="p-6 bg-primary-container flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <span
                                class="material-symbols-outlined text-on-primary-container animate-bounce">rocket_launch</span>
                            <h3
                                class="font-headline font-black text-on-primary-container uppercase tracking-tighter italic">
                                APEX AI</h3>
                        </div>
                        <span
                            class="px-2 py-0.5 bg-on-primary-container/20 rounded text-[9px] font-black text-on-primary-container tracking-widest uppercase">Real-Time
                            Analysis</span>
                    </div>
                    <div class="flex-1 p-6 space-y-4 max-h-[630px] overflow-y-auto" id="apex-chat-history">
                        <div class="space-y-1">
                            <div
                                class="bg-surface-container-low p-3 rounded-lg rounded-tl-none border-l-2 border-primary-container">
                                <p class="text-on-surface leading-relaxed text-sm">Analyzing your recent sector 2 data.
                                    You're losing 0.2s on Turn 4 due to early braking.</p>
                            </div>
                            <span class="text-[8px] font-bold text-outline uppercase tracking-widest ml-1">SYSTEM •
                                10:42 AM</span>
                        </div>
                        <div class="space-y-1">
                            <div
                                class="bg-primary-container/10 p-3 rounded-lg rounded-tl-none border-l-2 border-tertiary">
                                <p class="text-tertiary font-bold italic leading-relaxed text-sm">"Suggesting wider line
                                    on the hairpin to carry more exit speed."</p>
                            </div>
                            <span class="text-[8px] font-bold text-outline uppercase tracking-widest ml-1">COACH TIP •
                                LIVE</span>
                        </div>
                        <div class="space-y-1">
                            <div
                                class="bg-surface-container-low p-3 rounded-lg rounded-tl-none border-l-2 border-primary-container">
                                <p class="text-on-surface leading-relaxed text-sm">Optimal entry speed for Turn 4
                                    identified: <span class="text-primary-container font-black">62 KM/H</span>.</p>
                            </div>
                            <span class="text-[8px] font-bold text-outline uppercase tracking-widest ml-1">SYSTEM • JUST
                                NOW</span>
                        </div>
                    </div>
                    <div class="px-4 py-6 bg-surface-container-lowest border-t border-outline-variant/20">
                        <div class="relative">
                            <input
                                class="w-full bg-surface-container border-none rounded-lg py-3 px-4 text-on-surface focus:ring-1 focus:ring-primary-container placeholder:text-outline/50 font-medium text-sm"
                                id="apex-chat-input" placeholder="Ask Apex AI about your line..." type="text" />
                            <button
                                class="absolute right-2 top-1.5 p-1.5 text-primary-container hover:bg-primary-container/10 rounded-md"
                                id="apex-chat-send">
                                <span class="material-symbols-outlined text-sm">send</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- Community Trajectories Panel -->
        <section class="mt-12">
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h3 class="font-headline font-black text-2xl uppercase tracking-tighter italic">
                        TRAJECTORIES</h3>
                </div>
                @* <button
                    class="text-primary-container flex items-center gap-2 text-xs font-bold uppercase tracking-widest hover:underline">View
                    All</button> *@
            </div>
            <div class="flex gap-6 overflow-x-auto pb-4 no-scrollbar">
                <!-- Card 1 -->
            @foreach(var traj in Model.Trajectories)
            {
                 <div
                    class="flex-none w-72 bg-surface-container-low rounded-xl overflow-hidden border border-outline-variant/20 hover:border-primary-container/40 transition-all group">
                    <div class="h-36 bg-surface-container-highest relative flex items-center justify-center">
                        <img class="w-full" src="data:image/png;base64,@traj.Base64"/>
                    </div>
                    <div class="p-4 flex items-center justify-between bg-surface-container-high/50">
                        <div>
                            <div class="text-[9px] font-bold text-outline uppercase tracking-widest mt-0.5">By
                                @traj.User.UserName</div>
                        </div>
                        @* <div class="flex items-center gap-1 text-primary-container">
                            <span class="material-symbols-outlined text-sm"
                                style="font-variation-settings: 'FILL' 1;">favorite</span>
                            <span class="text-xs font-black">248</span>
                        </div> *@
                    </div>
                </div>
            }
           
            </div>
        </section>
        <!-- Location Map Section -->
        <section class="mt-12">
            <div class="bg-surface-container-low rounded-xl overflow-hidden">
                <div class="flex items-center justify-between p-6 border-b border-outline-variant/20">
                    <h3 class="font-headline font-black uppercase tracking-tighter italic">LOCATION MAP</h3>
                    <button
                        class="text-primary-container flex items-center gap-2 text-xs font-bold uppercase tracking-widest hover:underline">Open
                        in Maps</button>
                </div>
                <iframe src="@Model.GoogleMapsLink" style="filter: invert(100%)"class="w-full" height="700"
                             allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
            </div>
        </section>

    </main>

@section Scripts {
    <script>
        window.trackContext = @Html.Raw(JsonSerializer.Serialize(new {
      trackId = Model.Id,
      trackBase64 = Model.PictureBase64   // no .ToString() needed
  }));
    </script>

    <script type="module" src="~/lib/pintura/pintura.js"></script>
    <script type="module" src="~/js/trackdetails.js"></script>
    <script src="~/lib/node_modules/@@recogito/annotorious/dist/annotorious.min.js"></script>

}