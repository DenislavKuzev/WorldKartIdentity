@model WorldKartIdentity.ViewModel.ChallengeViewModel
@{
    ViewData["Title"] = "Trajectory Details";
    Layout = "~/Views/Shared/_NewLayout.cshtml";

    var challengerNotes = Model.ChallengerTrajectory.AnnotationBodies;
    var opponentNotes = Model.ChallengedTrajectory?.AnnotationBodies;
}
@section Styles {
    <link rel="stylesheet" href="~/css/challengesys.css" asp-append-version="true" />
}
<main class="w-full pt-20 min-h-screen overflow-y-auto bg-background">
    <div class="p-10 max-w-7xl mx-auto space-y-12">
        <!-- Header Section -->
        <div class="flex flex-col items-center justify-center text-center space-y-4">
            <h1 class="text-5xl md:text-7xl font-black font-display text-on-surface tracking-tighter">
                ПРЕДИЗВИКАТЕЛСТВО НА
                <span class="text-rose-600">ТРАЕКТОРИЯТА</span>
            </h1>
            <p class="text-slate-400 max-w-xl font-label text-sm uppercase tracking-[0.2em]">Анализирай вашата траектория спрямо други подобни</p>
        </div>
        <!-- Comparison Arena -->
        <div class="grid grid-cols-1 lg:grid-cols-11 gap-6 items-start">
            <!-- Left Panel: Challenger -->
            <div class="lg:col-span-5 space-y-4">
                <a href ="@Url.Action("TrajectoryDetails", "Track", new { id = Model.ChallengerTrajectory.Id })">
                    <p class="text-s text-slate-300 flex items-center gap-4 font-label italic">
                        <span class="material-symbols-outlined">arrow_back</span>
                        Обратно
                    </p>
                </a>
               
                <div class="glass-panel rounded-2xl overflow-hidden shadow-2xl">
                    <div class="p-6 border-b border-white/5 bg-surface-container-low flex justify-between items-center">
                        <div>
                            <span class="text-[12px] font-display font-bold uppercase tracking-[0.3em] text-rose-600 block mb-1">ПРЕДИЗВИКАТЕЛ</span>
                            <h3 class="text-3xl font-display text-white">@Model.ChallengerTrajectory.User.UserName</h3>
                        </div>
                    </div>
                    <div class="relative h-96 bg-surface-container">
                        <img alt="Track Schematic" class="w-full h-full opacity-60"
                             data-alt="A highly technical 2D schematic drawing of a professional race track with sharp corners and long straights. The background is a deep navy blue with a subtle grid pattern. The track itself is highlighted with a glowing neon rose-600 line showing a perfect racing trajectory, featuring heat-map dots indicating braking zones in vibrant red and acceleration points in cyan."
                             src="data:image/png;base64,@Model.ChallengerTrajectory.Base64" />
                    </div>
                    <div class="p-6 space-y-4 h-24 overflow-y-auto scrollbar-hide">
                        <div class="flex gap-3">
                            <div class="bg-white/5 p-3 rounded-lg flex-1">
                                <p class="text-xs text-slate-300 flex items-center gap-4 font-label italic">
                                    <span class="material-symbols-outlined">notes</span>
                                    @(challengerNotes.Any() ? $"{challengerNotes.Count()} бележки" : "Няма бележки")
                                </p>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Center Section: Initiate Challenge -->
            <div class="lg:col-span-1 flex flex-col items-center justify-center h-full pt-12 lg:pt-0">
                <div class="h-24 w-px bg-gradient-to-b from-transparent via-white/20 to-rose-600/50 hidden lg:block">
                </div>
                <button class="relative group" id="initiateBtn">
                    <div class="absolute -inset-6 bg-rose-600/20 rounded-full blur-2xl group-hover:bg-rose-600/40 transition-all duration-500">
                    </div>
                    <div class="relative z-10 w-20 h-20 bg-primary-container rounded-full flex items-center justify-center border-4 border-background shadow-[0_0_50px_rgba(225,29,72,0.4)] group-hover:scale-110 active:scale-95 transition-all duration-300">
                        <span class="material-symbols-outlined text-white text-3xl font-bold"
                              data-icon="bolt">bolt</span>
                    </div>
                    <div class="absolute top-full mt-4 left-1/2 -translate-x-1/2 whitespace-nowrap">
                    </div>
                </button>
                <div class="h-24 w-px bg-gradient-to-t from-transparent via-white/20 to-rose-600/50 hidden lg:block">
                </div>
            </div>


            <!-- Right Panel: Random Opponent (Updated with Reselect) -->
            <div class="lg:col-span-5 space-y-4">
                <a href="@Url.Action("TrajectoryDetails", "Track", new { id = Model.ChallengerTrajectory.Id })" class="invisible">
                    <p class="text-s text-slate-300 flex items-center gap-4 font-label italic">
                        <span class="material-symbols-outlined">arrow_back</span>
                        Обратно
                    </p>
                </a>
                <div class="glass-panel rounded-2xl overflow-hidden shadow-2xl">
                    <div class="p-6 border-b border-white/5 bg-surface-container-low flex justify-between items-center">
                        <div>
                            <div class="flex items-center gap-3 mb-1">
                                <span class="text-[12px] font-display font-bold uppercase tracking-[0.3em] text-slate-400">ОПОНЕНТ</span>
                                <button class="text-[11px] font-display font-bold text-white bg-rose-600 px-2 py-0.5 rounded hover:bg-rose-600 hover:text-white transition-all uppercase tracking-tighter"
                                        onclick="location.reload()">
                                    Избери отново
                                </button>
                            </div>
                            <h3 class="text-3xl font-display text-white" id="opponentName">
                                @Model.ChallengedTrajectory.User.UserName
                            </h3>
                        </div>

                    </div>
                    <div class="relative h-96 bg-surface-container">
                        <img alt="Track Schematic" class="w-full h-full opacity-60"
                             data-alt="A blueprint-style architectural drawing of a race track layout, rendered in neon cyan and muted navy blue tones. The schematic features complex geometric curves and technical annotations like apex markers and track width dimensions. High-contrast white lines indicate an aggressive racing trajectory that cuts deep into the apexes, suggesting a high-risk, high-reward driving style."
                             src="data:image/png;base64,@Model.ChallengedTrajectory.Base64" />

                    </div>
                    <div class="p-6 space-y-4 h-24 overflow-y-auto scrollbar-hide">
                        <div class="flex gap-3">
                            <div class="bg-white/5 p-3 rounded-lg flex-1">
                                <p class="text-xs text-slate-300 flex items-center gap-4 font-label italic">
                                    <span class="material-symbols-outlined">notes</span>
                                    @(opponentNotes.Any() ? $"{opponentNotes.Count()} бележки" : "Няма бележки")
                                </p>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        <!-- AI Analysis Section -->
        <div class="w-full">
            <div class="relative group">
                <div class="absolute -inset-1 bg-gradient-to-r from-rose-600/30 to-tertiary/30 rounded-3xl blur-xl opacity-20 group-hover:opacity-40 transition-all duration-700">
                </div>
                <div class="relative glass-panel rounded-3xl p-10 overflow-hidden">
                    <div class="flex items-center gap-4 mb-10">
                        <div class="w-12 h-12 bg-surface-container-highest rounded-xl flex items-center justify-center">
                            <span class="material-symbols-outlined text-rose-600"
                                  data-icon="psychology">psychology</span>
                        </div>
                        <div>
                            <h2 class="text-3xl text-white font-display uppercase tracking-widest">
                                AI АНАЛИЗ
                            </h2>
                        </div>
                    </div>
                    <!-- Analysis Content Container (Target for JS) -->
                    <div class="opacity-50 transition-all duration-500" id="analysisContent">
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
                            <!-- Detailed Breakdown -->
                            <div class="md:col-span-2 space-y-8 h-full">
                                <div class="bg-surface-container-lowest p-6 rounded-2xl border border-white/10 h-full flex items-top">
                                    <p class="text-sm font-label leading-relaxed text-slate-500 italic"
                                       id="technicalAdvisory">
                                        Стартирайте предизвикателството, за да започне анализ на траекториите.
                                    </p>
                                </div>
                            </div>
                            <!-- Victory State Container -->
                            <div class="relative flex flex-col items-center justify-center bg-surface-container-high/20 rounded-2xl p-8 text-center transition-all min-h-[300px]"
                                 id="victoryContainer">
                                <div class="absolute inset-0 bg-background/90 backdrop-blur-sm z-20 flex flex-col items-center justify-center rounded-2xl hidden opacity-100"
                                     id="processingOverlay">
                                    <div class="w-12 h-12 border-4 border-rose-600/30 border-t-rose-600 rounded-full animate-spin mb-4">
                                    </div>
                                    <p class="text-[10px] font-display font-black text-rose-600 uppercase tracking-[0.5em]"
                                       id="processingText">Анализ на телеметрията...</p>
                                </div>
                                <div class="space-y-4 opacity-0 scale-95 transition-all duration-700"
                                     id="victoryDetails">
                                    <span class="material-symbols-outlined text-6xl text-rose-600 mb-2"
                                          data-icon="trophy" data-weight="fill">trophy</span>
                                    <h4 class="text-4xl font-black font-display text-on-surface">ПОБЕДИТЕЛ</h4>
                                    <p class="text-rose-600 font-bold font-display text-2xl tracking-tighter"
                                       id="winnerName">—</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Footer Meta -->
    </div>
</main>
@section Scripts{
    <script>
        window.trajContext = {
            challengerId: "@Model.ChallengerTrajectory.Id",
            opponentId: "@Model.ChallengedTrajectory?.Id",
        };
       
       
        </script>
    <script src="~/js/challengesys.js"></script>
}