<div class="max-w-screen-2xl mx-auto pt-16 flex justify-center">
    <!-- Main Feed Content - Updated to max-w-6xl -->
    <main class="w-full max-w-6xl px-4 py-12">
        @* <div class="mb-12 text-center">
            <h1 class="font-headline font-extrabold text-4xl tracking-tighter text-on-surface mb-2 uppercase italic">
                KINETIC FEED
            </h1>
            <div class="h-1 w-20 bg-primary-container mx-auto"></div>
        </div> *@
        <!-- Feed Items Grid -->
        <div class="space-y-24">
            @foreach (var blog in Model)
            {
                <article class="group">
                    <div class="max-w-4xl mx-auto">
                        <div class="flex items-center gap-4 mb">
                            <img alt="Denis_Kuzev305" class="w-10 h-10 rounded-md object-cover ring-1 ring-outline/20"
                            src="@(blog.Author.Picture != string.Empty ? blog.Author.Picture : "/img/defaultprofilepic.png")" />
                            <div>
                                <h4 class="font-headline font-bold text-base text-on-surface group-hover:text-primary transition-colors">
                                    @blog.Author.UserName
                                </h4>
                                @* <p class="text-xs text-slate-500 font-body">2 hours ago • Track: Kyustendil</p> *@
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(blog.PictureBase64))
                        {
                            <div class="relative overflow-hidden rounded-md bg-surface-container-low shadow-2xl my-3">
                                <div class="absolute inset-0 bg-gradient-to-t from-background/80 to-transparent z-10 pointer-events-none">
                                </div>
                                <img alt="Karting Action"
                                class="w-full object-cover group-hover:scale-105 transition-transform duration-700 aspect-[21/9]"
                                src="data:image/png;base64, @blog.PictureBase64" />

                            </div>
                        }

                        <div class="mt-3">
                            <p class="font-body text-on-surface leading-relaxed mb-4 text-lg">
                                @blog.Content
                            </p>
                            <div class="flex items-center gap-8 text-slate-400">
                                <button class="flex items-center gap-2 @(blog.LikedByCurrentUser ? "text-rose-600" : "") hover:text-red-600 transition-colors group/btn like-buttons" data-bid="@blog.Id">
                                    <span class="material-symbols-outlined"
                                    style="font-variation-settings: 'FILL' 1;">favorite</span>
                                    <span class="text-xs font-bold font-headline likes">@blog.Likes</span>
                                </button>
                                @if (User?.IsInRole("Admin") == true)
                                {
                                    <form asp-action="DeleteBlog" asp-controller="Blog" method="post">
                                        <input type="hidden" name="Id" value="@blog.Id" />
                                        <button type="submit" class="delete-user-btn-nobcg">🗑️</button>
                                    </form>
                                }
                                @* <button class="flex items-center gap-2 hover:text-tertiary transition-colors group/btn"
                                        onclick="toggleComments('Post 1')">
                                    <span class="material-symbols-outlined">chat_bubble</span>
                                    <span class="text-xs font-bold font-headline">18</span>
                                </button>
                                <button class="flex items-center gap-2 hover:text-primary transition-colors ml-auto">
                                    <span class="material-symbols-outlined">share</span>
                                </button> *@
                            </div>
                        </div>
                    </div>
                </article>
            }
            
        </div>
    </main>
</div>
<!-- Floating Action Button -->
<button class="fixed bottom-24 right-8 md:bottom-12 md:right-12 w-16 h-16 bg-rose-600 text-white rounded-full shadow-2xl flex items-center justify-center hover:bg-rose-700 transition-all duration-300 scale-100 active:scale-90 z-40 group"
        onclick="togglePostModal()">
    <span class="material-symbols-outlined text-3xl group-hover:rotate-90 transition-transform duration-300">add</span>
</button>
<!-- Create Post Modal -->

<!-- Comment Drawer Overlay -->
<div class="drawer-overlay fixed inset-0 bg-background/80 backdrop-blur-sm z-50" id="drawerOverlay"
     onclick="closeComments()"></div>
<!-- Comment Drawer -->
