<div class="font-body min-h-screen flex items-center justify-center p-6">
    <main class="w-full max-w-md z-10">
        <!-- Central Reset Card -->
        <div class="surface-container-low glass-panel rounded-xl p-8 shadow-2xl">
            <header class="mb-8">
                <h2 class="font-display text-2xl font-bold text-on-surface mb-2">Промяна на парола</h2>
                <p class="text-on-surface-variant text-sm leading-relaxed">
                    Моля, въведете нова парола, която отговаря на
                    стандартите за безопасност.
                </p>
            </header>
            <div class="mb-6 hidden" id="status-message-container"></div>
            <form class="space-y-6" asp-action="ResetPassword" asp-controller="User" method="post">
                <input asp-for="Token" id="token" name="token" type="hidden" />
                <input asp-for="Email" id="email" type="hidden" name="email" />
                @Html.AntiForgeryToken()
                <!-- New Password Field -->
                <div class="space-y-2">
                    <label class="block font-display text-xs font-bold uppercase tracking-widest text-on-surface-variant">
                        Нова
                        парола
                    </label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-outline">
                            <span class="material-symbols-outlined text-xl">lock</span>
                        </div>
                        <input class="w-full bg-surface-container-highest border-none rounded-lg py-4 pl-12 pr-12 text-on-surface placeholder:text-outline/50 focus:ring-2 focus:ring-primary-container/50 transition-all font-body"
                               id="password" name="newPassword" asp-for="NewPassword" placeholder="••••••••" type="password" />
                        <button class="absolute view-password inset-y-0 right-0 pr-4 flex items-center text-outline hover:text-primary transition-colors"
                                type="button">
                            <span class="material-symbols-outlined" data-icon="visibility">visibility</span>
                        </button>
                    </div>
                </div>
                <!-- Confirm Password Field -->
                <div class="space-y-2">
                    <label class="block font-display text-xs font-bold uppercase tracking-widest text-on-surface-variant">
                        Потвърди
                        парола
                    </label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-outline">
                            <span class="material-symbols-outlined text-xl">verified_user</span>
                        </div>
                        <input class="w-full bg-surface-container-highest border-none rounded-lg py-4 pl-12 pr-12 text-on-surface placeholder:text-outline/50 focus:ring-2 focus:ring-primary-container/50 transition-all font-body"
                               id="confirm-password" placeholder="••••••••" type="password" />
                        <button class="absolute view-password inset-y-0 right-0 pr-4 flex items-center text-outline hover:text-primary transition-colors"
                                type="button">
                            <span class="material-symbols-outlined" data-icon="visibility">visibility</span>
                        </button>
                    </div>
                </div>
                <!-- Security Checklist -->
                <div class="p-4 rounded-lg bg-surface-container-lowest/50 ">
                    <h4 class="text-[10px] font-bold uppercase tracking-[0.2em] text-outline mb-3">
                        Валидация
                    </h4>
                    <ul class="space-y-2">
                        <li class="flex items-center gap-3 text-xs text-on-surface-variant/70">
                            <span class="material-symbols-outlined text-sm text-tertiary" data-icon="check_circle"
                                  data-weight="fill" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                            <span>Минимум 8 символа</span>
                        </li>
                        <li class="flex items-center gap-3 text-xs text-on-surface-variant/70">
                            <span class="material-symbols-outlined text-sm text-outline"
                                  data-icon="radio_button_unchecked">radio_button_unchecked</span>
                            <span>Съдържа сложни символи</span>
                        </li>
                        <li class="flex items-center gap-3 text-xs text-on-surface-variant/70">
                            <span class="material-symbols-outlined text-sm text-outline"
                                  data-icon="radio_button_unchecked">radio_button_unchecked</span>
                            <span>Паролите съвпадат</span>
                        </li>
                    </ul>
                </div>
                <!-- Action Button -->
                <button class="w-full bg-primary-container text-on-primary-container font-display font-bold py-4 px-6 rounded-lg flex items-center justify-center gap-3 hover:scale-[1.02] active:scale-[0.98] transition-all group relative overflow-hidden shadow-lg shadow-primary-container/20"
                        id="submit-btn" type="submit">
                    <span class="relative z-10">ЗАДАЙ НОВА ПАРОЛА</span>
                    <span class="material-symbols-outlined relative z-10 transition-transform group-hover:translate-x-1"
                          data-icon="bolt" data-weight="fill" style="font-variation-settings: 'FILL' 1;">bolt</span>
                    <div class="absolute inset-0 bg-gradient-to-r from-on-primary-fixed-variant/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity">
                    </div>
                </button>
            </form>
            <!-- Navigation Back -->
            <div class="mt-8 pt-6 border-t border-outline-variant/10 text-center">
                <a class="inline-flex items-center gap-2 font-display text-sm font-bold text-outline hover:text-primary-container transition-colors group"
                   href="/User/Login">
                    <span class="material-symbols-outlined text-base group-hover:-translate-x-1 transition-transform"
                          data-icon="arrow_back">arrow_back</span>
                    ВЪРНИ СЕ КЪМ ВХОД
                </a>
            </div>
        </div>
        <!-- Support Info -->
    </main>
</div>
