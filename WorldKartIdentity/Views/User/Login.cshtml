 @model WorldKartIdentity.ViewModel.UserViewModel

@{
    ViewData["Title"] = "Вход";
    Layout = "~/Views/Shared/_NewLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/loginregistration.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700;900&amp;family=Inter:wght@300;400;500;600;700&amp;display=swap"
          rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
          rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
          rel="stylesheet" />
}

@section Scripts {
    <script src="~/js/loginpage.js" asp-append-version="true"></script>
 
}


  <main class="flex-grow flex items-center justify-center relative overflow-hidden px-4 py-12"> 
    <!-- Background Kinetic Element -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[150%] h-[150%] opacity-10 pointer-events-none">
        <div class="absolute inset-0 bg-gradient-to-tr from-primary-container via-transparent to-tertiary transform -rotate-12">
        </div>
    </div>
    <!-- Login Card -->
    <div class="w-full max-w-md relative z-10">
        <div class="glass-panel border border-outline-variant/15 p-10 rounded-xl shadow-2xl">
            <div class="mb-10 text-center">
                <h1 class="headline-font text-4xl font-bold tracking-tight text-on-surface mb-2">Вход</h1>
                <div class="w-12 h-1 bg-primary-container mx-auto"></div>
            </div>
            <div class="hidden mb-6 p-4 rounded-lg bg-error-container text-on-error-container border border-error/20 flex items-center gap-3"
                 id="login-error-container">
                <span class="material-symbols-outlined text-xl">error</span>
                <p class="text-sm font-medium" id="login-error-message"></p>
            </div>
            <form id="loginForm" class="space-y-6" method="post">
                @Html.AntiForgeryToken()

                <div id="loginMessage" class="hidden rounded-lg px-4 py-3 text-sm font-medium"></div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-widest text-red-300 mb-2 ml-1"
                           for="email">Имейл</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-white">mail</span>
                        <input class="w-full bg-surface-container-highest border-none rounded-lg py-4 pl-12 pr-4 text-on-surface placeholder:text-white focus:ring-0 focus:ring-offset-0 transition-all border-b-2 border-transparent focus:border-primary-container"
                               id="email"
                               name="Email"
                               type="email"
                               required />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-widest text-red-300 mb-2 ml-1"
                           for="password">Парола</label>
                    <div class="relative">
                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-white">lock</span>
                        <input class="w-full bg-surface-container-highest border-none rounded-lg py-4 pl-12 pr-4 text-on-surface placeholder:text-white focus:ring-0 focus:ring-offset-0 transition-all border-b-2 border-transparent focus:border-primary-container"
                               id="password"
                               name="Password"
                               placeholder="••••••••"
                               type="password"
                               required />
                    </div>
                </div>

                <div class="flex items-center justify-between">

                    <a class="text-sm text-red-300 forgot-link hover:text-primary-container transition-colors"
                       href="#">Забравена парола?</a>
                </div>

                <button id="loginBtn"
                        class="w-full bg-primary-container text-on-primary-container headline-font font-black py-4 rounded-lg text-lg tracking-widest uppercase shadow-lg shadow-primary-container/20 hover:scale-[1.02] active:scale-[0.98] transition-all relative overflow-hidden group"
                        type="submit">
                    <span class="relative z-10">Вход</span>
                    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-500"></div>
                </button>

                <div class="flex items-center gap-4 my-6">
                    <div class="h-px flex-grow bg-outline-variant/20"></div>
                    <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-red-300">ИЛИ</span>
                    <div class="h-px flex-grow bg-outline-variant/20"></div>
                </div>

                <button class="w-full flex items-center justify-center gap-3 bg-surface-container-highest py-4 rounded-lg text-sm font-bold tracking-widest uppercase hover:bg-surface-bright transition-all google-login"
                        type="button">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                              fill="#4285F4"></path>
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                              fill="#34A853"></path>
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"
                              fill="#FBBC05"></path>
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                              fill="#EA4335"></path>
                    </svg>
                    <span class="text-white">Вход с Google</span>
                </button>
            </form>
            <div class="mt-8 pt-8 border-t border-outline-variant/10 text-center">
                <p class="text-mid text-red-300">
                    Нямате акаунт?
                    <a class="text-primary-container font-bold hover:underline underline-offset-4 ml-1"
                       href="@Url.Action("Registration", "User")">Регистрация</a>
                </p>
            </div>
        </div>
        <!-- Asymmetric Decor -->
        <div class="hidden lg:block absolute -right-24 -bottom-12 w-48 h-48 rounded-xl opacity-20 pointer-events-none rotate-12 bg-surface-container-high border border-primary-container/30">
        </div>
        <div class="hidden lg:block absolute -left-16 -top-8 w-24 h-24 rounded-full opacity-10 pointer-events-none bg-tertiary-container">
        </div>
    </div>
 </main>  
