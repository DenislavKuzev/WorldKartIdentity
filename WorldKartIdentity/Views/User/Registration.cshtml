@model WorldKartIdentity.ViewModel.UserViewModel

@{
    ViewData["Title"] = "Registration";
    Layout = "~/Views/Shared/_NewLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/loginregistration.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/registrationvalidation.js" asp-append-version="true"></script>
}


<main class="flex-grow flex flex-col items-center justify-center pt-24 pb-12 relative px-4">
    <!-- Racing Inspired Background Elements -->
    <div class="absolute inset-0 racing-grid pointer-events-none opacity-40"></div>
    <div class="absolute top-1/4 -left-24 w-96 h-96 bg-primary-container/10 blur-[120px] rounded-full pointer-events-none">
    </div>
    <div class="absolute bottom-1/4 -right-24 w-96 h-96 bg-tertiary-container/10 blur-[120px] rounded-full pointer-events-none">
    </div>
    <!-- Animated Speed Streaks (Simulated) -->
    <div class="absolute top-0 right-0 w-full h-full overflow-hidden pointer-events-none opacity-20">
        <div class="absolute top-[20%] right-[-10%] w-[150%] h-[1px] bg-gradient-to-r from-transparent via-primary to-transparent -rotate-12">
        </div>
        <div class="absolute top-[50%] right-[-10%] w-[150%] h-[1px] bg-gradient-to-r from-transparent via-tertiary to-transparent -rotate-12">
        </div>
    </div>
    <!-- Sign-Up Card Container -->
    <div class="w-full max-w-md z-10">
        <div class="bg-surface-container-low border border-white/5 rounded-2xl p-8 md:p-10 shadow-2xl relative overflow-hidden">
            <!-- Branding Accent -->
            <div class="absolute top-0 left-0 w-1 h-full bg-primary-container"></div>
            <!-- Editorial Header -->
            <div class="mb-10 text-left">
                <h1 class="font-headline text-4xl font-black uppercase tracking-tighter text-on-surface mb-2 leading-none">
                    Присъедини се към <span class="text-primary-container">елита</span>
                </h1>
                <p class="text-on-secondary-container font-medium text-sm tracking-wide">
                    Създай своя профил и
                    доминирай на пистата.
                </p>
            </div>
            <!-- Registration Form -->
            <div class="hidden mb-4 p-4 rounded-xl text-sm font-medium" id="form-status"></div>
            <form class="space-y-6 signup">
                <!-- Username Field -->
                <div class="space-y-2">
                    <label class="font-headline text-xs font-bold uppercase tracking-widest text-slate-500 ml-1"
                           for="username">Потребителско име</label>
                    <div class="relative group">
                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm group-focus-within:text-primary transition-colors">person</span>
                        <input class="w-full bg-surface-container-highest border-none rounded-xl py-4 pl-12 pr-4 text-on-surface placeholder:text-slate-600 focus:ring-2 focus:ring-primary-container/20 transition-all text-sm font-medium"
                               id="username" name="UserName" placeholder="kart_master_99" type="text" />
                        <p class="text-[10px] text-rose-500 font-bold uppercase tracking-wider mt-1 hidden"
                           id="UserName-error"></p>
                    </div>
                </div>
                <!-- Email Field -->
                <div class="space-y-2">
                    <label class="font-headline text-xs font-bold uppercase tracking-widest text-slate-500 ml-1"
                           for="email">Имейл</label>
                    <div class="relative group">
                        <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm group-focus-within:text-primary transition-colors">alternate_email</span>
                        <input class="w-full bg-surface-container-highest border-none rounded-xl py-4 pl-12 pr-4 text-on-surface placeholder:text-slate-600 focus:ring-2 focus:ring-primary-container/20 transition-all text-sm font-medium"
                               id="email" name="Email" placeholder="example@apex.bg" type="email" />
                        <p class="text-[10px] text-rose-500 font-bold uppercase tracking-wider mt-1 hidden"
                           id="Email-error"></p>
                    </div>
                </div>
                <!-- Password Fields Group -->
                <div class="grid grid-cols-1 gap-6">
                    <div class="space-y-2">
                        <label class="font-headline text-xs font-bold uppercase tracking-widest text-slate-500 ml-1"
                               for="password">Парола</label>
                        <div class="relative group">
                            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm group-focus-within:text-primary transition-colors">lock</span>
                            <input class="w-full bg-surface-container-highest border-none rounded-xl py-4 pl-12 pr-4 text-on-surface placeholder:text-slate-600 focus:ring-2 focus:ring-primary-container/20 transition-all text-sm font-medium"
                                   id="password" name="Password" placeholder="••••••••" type="password" />
                            <p class="text-[10px] text-rose-500 font-bold uppercase tracking-wider mt-1 hidden"
                               id="Password-error"></p>
                        </div>
                    </div>
                    <div class="space-y-2">
                        <label class="font-headline text-xs font-bold uppercase tracking-widest text-slate-500 ml-1"
                               for="confirm-password">Повтори парола</label>
                        <div class="relative group">
                            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 text-sm group-focus-within:text-primary transition-colors">verified_user</span>
                            <input class="w-full bg-surface-container-highest border-none rounded-xl py-4 pl-12 pr-4 text-on-surface placeholder:text-slate-600 focus:ring-2 focus:ring-primary-container/20 transition-all text-sm font-medium"
                                   id="confirm-password" name="RepeatPassword" placeholder="••••••••"
                                   type="password" />
                            <p class="text-[10px] text-rose-500 font-bold uppercase tracking-wider mt-1 hidden"
                               id="RepeatPassword-error"></p>
                        </div>
                    </div>
                </div>
                <!-- Submit Button -->
                <button class="w-full bg-primary-container hover:bg-rose-700 text-on-primary-container font-headline font-bold py-3 rounded-xl uppercase tracking-widest text-sm shadow-lg shadow-rose-600/20 transform hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-3 mt-4"
                        type="submit">
                    <span>Регистрирай се</span>
                    <span class="material-symbols-outlined text-lg">arrow_forward</span>
                </button>
            </form>
            <!-- Footer Link -->
            <div class="mt-10 text-center">
                <p class="text-slate-500 text-sm font-medium">
                    Вече имате акаунт?
                    <a class="text-primary hover:text-rose-400 underline underline-offset-4 ml-1 transition-colors"
                       href="#">Вход</a>
                </p>
            </div>
        </div>
    </div>
</main>
