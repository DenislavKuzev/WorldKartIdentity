@model WorldKartIdentity.ViewModel.UserViewModel

@{
    ViewData["Title"] = "Потребителски профил";
    Layout = "~/Views/Shared/_NewLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/userprofile.css" asp-append-version="true" />
}

<main class="pt-24 pb-32 px-6 md:px-12">
    <div class="max-w-6xl mx-auto">
        <!-- Profile Header Section -->
        <section class="relative mb-12 flex flex-col md:flex-row gap-8 items-end">
            <div class="relative group">
                <div class="absolute -inset-1 bg-gradient-to-tr from-rose-600 to-transparent rounded-2xl blur opacity-25 group-hover:opacity-50 transition duration-1000">
                </div>
                @if (!string.IsNullOrEmpty(Model.Picture))
                {
                   <img alt="Профилна снимка"
                     class="relative w-48 h-48 md:w-64 md:h-64 object-cover rounded-xl transition-all duration-500 border border-white/10"
                     data-alt="Професионален близък портрет на състезателен пилот с модерен карбонов шлем, с вдигнат визьор и фокусиран поглед. Осветлението е кинематографично, със силна странична светлина в тъмна гаражна среда. Дълбоки тъмносини тонове доминират в сенките, а острите червени акценти от логото на отбора върху екипа изпъкват на светлината. Общото настроение е сериозно, елитно и високопроизводително."
                    src="@Model.Picture" />
                }
                else
                {
                    <img alt="Профилна снимка"
                     class="relative w-48 h-48 md:w-64 md:h-64 object-cover rounded-xl transition-all duration-500 border border-white/10"
                     data-alt="Професионален близък портрет на състезателен пилот с модерен карбонов шлем, с вдигнат визьор и фокусиран поглед. Осветлението е кинематографично, със силна странична светлина в тъмна гаражна среда. Дълбоки тъмносини тонове доминират в сенките, а острите червени акценти от логото на отбора върху екипа изпъкват на светлината. Общото настроение е сериозно, елитно и високопроизводително."
                     src="/img/defaultprofilepic.png" />
                }

            </div>

            <div class="flex-1 flex flex-col md:flex-row justify-between items-start md:items-end w-full pb-2">
                <div>
                    <span class="inline-block bg-secondary-container text-on-secondary-container px-3 py-1 rounded text-[10px] font-headline font-bold tracking-[0.2em] mb-4 uppercase">
                        @Model.RoleInKarting
                    </span>
                    <h1 class="text-5xl md:text-7xl font-headline font-black text-white tracking-tighter uppercase leading-none">
                        @Model.UserName
                    </h1>
                </div>
            </div>
        </section>

        <!-- Grid Layout for Bio and Data -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <!-- Left Column: Bio and Trajectories -->
            <div class="lg:col-span-8 space-y-12">
                <!-- Bio Block -->
                <div class="bg-surface-container-low p-8 rounded-2xl relative overflow-hidden">
                    <div class="absolute top-0 right-0 p-4 opacity-5">
                        <span class="material-symbols-outlined text-9xl"
                              data-icon="format_quote">format_quote</span>
                    </div>

                    <h3 class="text-s font-headline text-slate-500 tracking-widest uppercase mb-4">
                        Биография
                    </h3>

                    <p class="text-on-surface-variant text-lg leading-relaxed font-light">
                        @if (string.IsNullOrEmpty(Model.Bio))
                        {
                            <span class="text-slate-500 italic">
                                Все още няма биография. Добавете малко информация за себе си, за да помогнете на другите да ви опознаят по-добре!
                            </span>
                        }
                        else
                        {
                            @Model.Bio
                        }
                    </p>
                </div>

                <!-- My Trajectories Section -->
                <div class="accordion-panel">
                    <div class="flex justify-between items-center mb-6 cursor-pointer group/header"
                         onclick="toggleAccordion(this)">
                        <div class="flex items-center gap-3">
                            <span class="w-2 h-8 bg-rose-600"></span>
                            <h2 class="text-2xl font-headline font-bold text-white uppercase tracking-tight">
                                Моите траектории
                            </h2>
                            <span class="material-symbols-outlined text-slate-500 transition-transform duration-300 transform rotate-180 accordion-chevron">expand_more</span>
                        </div>
                        @* <button class="text-xs font-headline font-bold text-slate-500 hover:text-rose-500 transition-colors uppercase tracking-widest"
                                onclick="event.stopPropagation()">
                            View All
                        </button> *@
                    </div>
                    <div class="accordion-content transition-all duration-300">
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                            @foreach (var traj in Model.TrackTrajectories)
                            {
                                 <a class="group bg-surface-container-high rounded-xl overflow-hidden hover:border-rose-500/50 transition-all duration-300"
   asp-action="TrajectoryDetails"
   asp-controller="Track"
   asp-route-id="@traj.Id">
    <div class="aspect-square bg-slate-900 flex items-center justify-center p-4 relative">
        <img alt="Траектория"
             class="object-contain opacity-70 group-hover:opacity-100 group-hover:scale-110 transition-all duration-500"
             src="data:image/png;base64,@traj.Base64" />
    </div>
</a>
                            }
                        </div>
                    </div>
                </div>
                <div class="accordion-panel mt-12">
                    <div class="flex justify-between items-center mb-6 cursor-pointer group/header"
                         onclick="toggleAccordion(this)">
                        <div class="flex items-center gap-3">
                            <span class="w-2 h-8 bg-tertiary"></span>
                            <h2 class="text-2xl font-headline font-bold text-white uppercase tracking-tight">
                                Харесани блогове
                            </h2>
                            <span class="material-symbols-outlined text-slate-500 transition-transform duration-300 transform rotate-180 accordion-chevron">expand_more</span>
                        </div>
                    </div>
                    <div class="accordion-content transition-all duration-300">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            @foreach (var b in Model.LikedBlogs)
                            {
                                <div class="group bg-surface-container-high rounded-xl overflow-hidden hover:border-tertiary/50 transition-all duration-300 flex">
                                    
                                    <div class="p-4 flex flex-col justify-between flex-1">
                                        <div>
                                            <h4 class="text-sm font-headline font-bold text-white uppercase leading-tight group-hover:text-tertiary transition-colors truncate max-w-[30ch]">
                                                @b.Content
                                            </h4>
                                        </div>
                                        <div class="flex items-center gap-2 pt-2 mt-2">
                                            <img alt="Markus Thorne"
                                                 class="w-5 h-5 rounded-full object-cover ring-1 ring-white/20"
                                                 src="@(string.IsNullOrEmpty(b.Author.Picture) ? "/img/defaultprofilepic.png" : b.Author.Picture)" />
                                            <span class="text-[10px] text-on-surface-variant font-medium">@b.Author.UserName</span>
                                        </div>
                                    </div>
                                </div>
                                                        }
                           
                        </div>
                    </div>
                </div>
                <div class="accordion-panel mt-12">
                    <div class="flex justify-between items-center mb-6 cursor-pointer group/header"
                         onclick="toggleAccordion(this)">
                        <div class="flex items-center gap-3">
                            <span class="w-2 h-8 bg-primary-container"></span>
                            <h2 class="text-2xl font-headline font-bold text-white uppercase tracking-tight">
                                Харесани писти
                            </h2>
                            <span class="material-symbols-outlined text-slate-500 transition-transform duration-300 transform rotate-180 accordion-chevron">expand_more</span>
                        </div>
                    </div>
                    <div class="accordion-content transition-all duration-300">
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                            @foreach(var track in Model.LikedTracks)
                            {
                                <div class="group h-auto bg-surface-container-high rounded-xl overflow-hidden hover:border-primary/50 transition-all duration-300">
                                <div class="aspect-rectangle bg-slate-900 flex items-center justify-center relative">
                                    <img
                                         class="object-contain rounded-t-xl opacity-80 group-hover:opacity-100 transition-all"
                                         src="data:image/png;base64, @track.PhotographBase64" />
                                </div>
                                <div class="p-3">
                                    <h4 class="text-s font-headline font-bold text-white uppercase">Zandvoort</h4>
                                </div>
                            </div>
                            }
                            
                        </div>
                    </div>
                </div>
            </div>
            <!-- Right Column: Personal Data -->
               <div class="lg:col-span-4">
                <div class="bg-surface-container-low rounded-2xl p-8 sticky top-32">
                    <h3 class="text-xs font-headline font-bold text-rose-500 tracking-widest uppercase mb-8">
                        Лични данни
                    </h3>

                    <div class="space-y-6">
                        <a asp-action="Logout"
                           asp-controller="User"
                           class="w-full mb-8 font-['Space_Grotesk'] uppercase tracking-wider text-sm font-black bg-rose-600 text-white px-6 py-3 rounded-xl hover:bg-rose-700 transition-all duration-200 active:scale-95 flex items-center justify-center gap-3 shadow-lg shadow-rose-600/20">
                            <span class="material-symbols-outlined">logout</span>
                            Излез
                        </a>

                        <a asp-action="EditUserProfile"
                           asp-controller="User"
                           class="w-full mb-8 font-['Space_Grotesk'] uppercase tracking-wider text-sm font-black bg-rose-600 text-white px-6 py-3 rounded-xl hover:bg-rose-700 transition-all duration-200 active:scale-95 flex items-center justify-center gap-3 shadow-lg shadow-rose-600/20">
                            <span class="material-symbols-outlined">edit</span>
                            Редактирай
                        </a>

                        <div class="group">
                            <p class="text-[10px] text-slate-500 uppercase font-bold tracking-widest mb-1">
                                Име
                            </p>
                            <p class="text-white font-headline text-lg group-hover:text-rose-400 transition-colors">
                                @Model.UserName
                            </p>
                        </div>

                        <div class="group">
                            <p class="text-[10px] text-slate-500 uppercase font-bold tracking-widest mb-1">
                                Имейл
                            </p>
                            <p class="text-white font-headline text-lg group-hover:text-rose-400 transition-colors">
                                @Model.Email
                            </p>
                        </div>

                        <div class="group">
                            <p class="text-[10px] text-slate-500 uppercase font-bold tracking-widest mb-1">
                                Телефонен номер
                            </p>
                            <p class="text-white font-headline text-lg group-hover:text-rose-400 transition-colors">
                                @Model.PhoneNumber
                            </p>
                        </div>

                        <div class="group">
                            <p class="text-[10px] text-slate-500 uppercase font-bold tracking-widest mb-1">
                                Държава
                            </p>
                            <div class="flex items-center gap-3">
                                <p class="text-white font-headline text-lg group-hover:text-rose-400 transition-colors">
                                    @Model.Country
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col gap-4 mt-10">
                        <h4>Социални мрежи</h4>

                        <div class="flex gap-8">
                            @if (string.IsNullOrEmpty(Model.FacebookUrl))
                            {   
                              <a class="w-10 h-10 rounded-full border border-outline-variant flex items-center justify-center text-on-surface hover:bg-white/5 transition-colors"
                                href="@Model.FacebookUrl">
                                 <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 71 72"
                                     fill="#ffffff">
                                    <path d="M46.4233 38.6403L47.7279 30.3588H39.6917V24.9759C39.6917 22.7114 40.8137 20.4987 44.4013 20.4987H48.1063V13.4465C45.9486 13.1028 43.7685 12.9168 41.5834 12.8901C34.9692 12.8901 30.651 16.8626 30.651 24.0442V30.3588H23.3193V38.6403H30.651V58.671H39.6917V38.6403H46.4233Z" />
                                 </svg>
                              </a>                            }
                            
                             @if (string.IsNullOrEmpty(Model.InstagramUrl))
                            {
                               <a class="w-10 h-10 rounded-full border border-outline-variant flex items-center justify-center text-on-surface hover:bg-white/5 transition-colors"
                               href="@Model.InstagramUrl">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 71 72"
                                     fill="none">
                                    <path d="M27.3762 35.7808C27.3762 31.1786 31.1083 27.4468 35.7132 27.4468C40.3182 27.4468 44.0522 31.1786 44.0522 35.7808C44.0522 40.383 40.3182 44.1148 35.7132 44.1148C31.1083 44.1148 27.3762 40.383 27.3762 35.7808ZM22.8683 35.7808C22.8683 42.8708 28.619 48.618 35.7132 48.618C42.8075 48.618 48.5581 42.8708 48.5581 35.7808C48.5581 28.6908 42.8075 22.9436 35.7132 22.9436C28.619 22.9436 22.8683 28.6908 22.8683 35.7808ZM46.0648 22.4346C46.0646 23.0279 46.2404 23.608 46.5701 24.1015C46.8997 24.595 47.3684 24.9797 47.9168 25.2069C48.4652 25.4342 49.0688 25.4939 49.6511 25.3784C50.2334 25.2628 50.7684 24.9773 51.1884 24.5579C51.6084 24.1385 51.8945 23.6041 52.0105 23.0222C52.1266 22.4403 52.0674 21.8371 51.8404 21.2888C51.6134 20.7406 51.2289 20.2719 50.7354 19.942C50.2418 19.6122 49.6615 19.436 49.0679 19.4358H49.0667C48.2708 19.4361 47.5077 19.7522 46.9449 20.3144C46.3821 20.8767 46.0655 21.6392 46.0648 22.4346ZM25.6072 56.1302C23.1683 56.0192 21.8427 55.6132 20.9618 55.2702C19.7939 54.8158 18.9606 54.2746 18.0845 53.4002C17.2083 52.5258 16.666 51.6938 16.2133 50.5266C15.8699 49.6466 15.4637 48.3214 15.3528 45.884C15.2316 43.2488 15.2073 42.4572 15.2073 35.781C15.2073 29.1048 15.2336 28.3154 15.3528 25.678C15.4639 23.2406 15.8731 21.918 16.2133 21.0354C16.668 19.8682 17.2095 19.0354 18.0845 18.1598C18.9594 17.2842 19.7919 16.7422 20.9618 16.2898C21.8423 15.9466 23.1683 15.5406 25.6072 15.4298C28.244 15.3086 29.036 15.2844 35.7132 15.2844C42.3904 15.2844 43.1833 15.3106 45.8223 15.4298C48.2612 15.5408 49.5846 15.9498 50.4677 16.2898C51.6356 16.7422 52.4689 17.2854 53.345 18.1598C54.2211 19.0342 54.7615 19.8682 55.2161 21.0354C55.5595 21.9154 55.9658 23.2406 56.0767 25.678C56.1979 28.3154 56.2221 29.1048 56.2221 35.781C56.2221 42.4572 56.1979 43.2466 56.0767 45.884C55.9656 48.3214 55.5573 49.6462 55.2161 50.5266C54.7615 51.6938 54.2199 52.5266 53.345 53.4002C52.4701 54.2738 51.6356 54.8158 50.4677 55.2702C49.5872 55.6134 48.2612 56.0194