                                          fill="#ffffff" />
                                </svg>
                            </a> 
                            }
                            
                             @if (string.IsNullOrEmpty(Model.TikTokUrl))
                            {
                              <a class="w-10 h-10 rounded-full border border-outline-variant flex items-center justify-center text-on-surface hover:bg-white/5 transition-colors"
                               href="@Model.TikTokUrl">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 72 72"
                                     fill="none">
                                    <path d="M50.0783 22.6244C49.7746 22.4674 49.4789 22.2953 49.1924 22.1088C48.3592 21.5579 47.5952 20.9089 46.9171 20.1756C45.2202 18.2341 44.5864 16.2644 44.353 14.8853H44.3624C44.1674 13.7406 44.248 13 44.2602 13H36.5314V42.8856C36.5314 43.2869 36.5314 43.6834 36.5146 44.0753C36.5146 44.1241 36.5099 44.1691 36.5071 44.2216C36.5071 44.2431 36.5071 44.2656 36.5024 44.2881C36.5024 44.2938 36.5024 44.2994 36.5024 44.305C36.4209 45.3773 36.0772 46.4131 35.5014 47.3214C34.9257 48.2297 34.1355 48.9825 33.2005 49.5138C32.226 50.0681 31.1238 50.359 30.0027 50.3575C26.4017 50.3575 23.4833 47.4213 23.4833 43.795C23.4833 40.1688 26.4017 37.2325 30.0027 37.2325C30.6843 37.2319 31.3618 37.3391 32.0099 37.5503L32.0192 29.6809C30.0518 29.4268 28.053 29.5832 26.149 30.1402C24.245 30.6972 22.477 31.6427 20.9567 32.9172C19.6246 34.0746 18.5047 35.4557 17.6474 36.9981C17.3211 37.5606 16.0902 39.8209 15.9411 43.4894C15.8474 45.5716 16.4727 47.7288 16.7708 48.6203V48.6391C16.9583 49.1641 17.6849 50.9556 18.8689 52.4659C19.8237 53.6774 20.9518 54.7417 22.2167 55.6244V55.6056L22.2355 55.6244C25.9771 58.1669 30.1255 58 30.1255 58C30.8436 57.9709 33.2492 58 35.9811 56.7053C39.0111 55.27 40.7361 53.1316 40.7361 53.1316C41.8381 51.8538 42.7144 50.3977 43.3274 48.8256C44.0267 46.9872 44.2602 44.7822 44.2602 43.9009V28.0459C44.3539 28.1022 45.6027 28.9281 45.6027 28.9281C45.6027 28.9281 47.4017 30.0813 50.2086 30.8322C52.2224 31.3666 54.9355 31.4791 54.9355 31.4791V23.8066C53.9849 23.9097 52.0546 23.6097 50.0783 22.6244Z"
                                          fill="#ffffff" />
                                </svg>
                            </a>  
                                                        }
                            
                            @if (string.IsNullOrEmpty(Model.YoutubeUrl))
                            {    
                                <a class="w-10 h-10 rounded-full border border-outline-variant flex items-center justify-center text-on-surface hover:bg-white/5 transition-colors"
                               href="@Model.YoutubeUrl">
                                <span class="material-symbols-outlined text-xl">play_circle</span>
                               </a>                            }
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>

            <!-- Right Column: Personal Data -->
        
        </div>
    </div>
</main>


@* <a class="group bg-surface-container-high rounded-xl overflow-hidden hover:border-rose-500/50 transition-all duration-300"
   asp-action="TrajectoryDetails"
   asp-controller="Track"
   asp-route-id="@traj.Id">
    <div class="aspect-square bg-slate-900 flex items-center justify-center p-4 relative">
        <img alt="Траектория"
             class="object-contain opacity-70 group-hover:opacity-100 group-hover:scale-110 transition-all duration-500"
             src="data:image/png;base64,@traj.Base64" />
    </div>
</a> *@
@section Scripts{
    <script src="~/js/userprofile.js" ></script>
}