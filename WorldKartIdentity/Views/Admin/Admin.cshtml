@model WorldKartIdentity.ViewModel.AdminViewModel

@{
    ViewData["Title"] = "Admin Library";
    Layout = "~/Views/Shared/_NewLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/adminpanel.css" asp-append-version="true" />
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container-fluid admin-body">
    <div class="row">
        <div class="col-md-2 bg-light sidebar p-3">
            <h4 class="text-center mb-4 text-danger">Админ меню</h4>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link" asp-action="Tracks" asp-controller="Admin">Писти</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="TrackRequests" asp-controller="Admin">Заявени писти</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="CreateTrack" asp-controller="Track">Създаване на писта</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="BlogReports" asp-controller="Admin">Докладвани постове</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="Users" asp-controller="Admin">Потребители</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-action="BlockedUsers" asp-controller="Admin">Блокирани потребители</a>
                </li>
            </ul>
        </div>

        <div class="col-md-10">
            <h2 class=" text-center mb-4 text-white">Админ панел</h2>
            <div class="row">
                <div class="col-md-4">
                    <div class="card card-custom mb-3 shadow">
                        <div class="card-body text-center">
                            <h5 class="card-title">Картинг писти</h5>
                            <h2 class="card-text"> @Model.TracksCount </h2>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card card-custom mb-3 shadow">
                        <div class="card-body text-center">
                            <h5 class="card-title">Траектории</h5>
                            <h2 class="card-text"> @Model.TrackTrajectoriesCount </h2>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card card-custom mb-3 shadow">
                        <div class="card-body text-center">
                            <h5 class="card-title">Хора създали траектории</h5>
                            <h2 class="card-text"> @Model.UsersCreatedTrajectoriesCount </h2>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-12">
                    <div class="card shadow">
                        <div class="card-body">
                            <h5 class="card-title">Графикa</h5>
                            <div style="height: 400px; width: 1100px;">
                                <canvas id="adminChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const ctx = document.getElementById('adminChart').getContext('2d');

    const adminChart = new Chart(ctx, {
        type: 'bar', // може и 'pie' или 'doughnut'
        data: {
            labels: ['Писти', 'Траектории', 'Потребители'],
            datasets: [{
                label: 'Статистика',
                data: [
    @Model.TracksCount,
    @Model.TrackTrajectoriesCount,
    @Model.UsersCreatedTrajectoriesCount
                ],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    display: false
                }
            },
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });
</script>