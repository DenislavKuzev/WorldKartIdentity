@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_NewLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/aboutus.css" asp-append-version="true" />
}

<main class="pt-32 pb-24">
    <div class="editorial-grid px-6">
        <div class="editorial-content">
            <!-- Hero Section / Header -->
            <section class="mb-20">
                <h1 class="font-display text-4xl md:text-6xl font-black text-on-surface mb-8 tracking-tighter leading-none border-l-8 border-primary-container pl-6 uppercase">
                    За нас
                </h1>
                <p class="font-body text-lg md:text-xl text-on-surface-variant leading-relaxed max-w-3xl">
                    Ние сме
                    Денислав Кузев и Станислав Райкин ученици от ПМГ "Константин Величков" гр.Пазарджик и сме
                    създателите на платфомата - СВЕТОВНА КАРТИНГ АРЕНА. Денислав е дългогодишен състезател по
                    картинг в професионални и аматьорски шампионати и се занимава с програмиране на уеб сайтове от 2
                    години. Станислав се занимава от 4 години с програмиране и създава уеб приложения като през
                    свободното си време обича да спортува плуване. Нашата цел е да развиваме платформата постоянно и
                    да я превърнем в място, което помага на състезателите да стават по-бързи, по-уверени и
                    по-подготвени.
                </p>
            </section>
            <!-- Section: What is Kinetic Arena -->
            <section class="mb-20 py-12 border-t border-outline-variant/20">
                <h2 class="font-display text-2xl md:text-3xl font-bold text-primary-container mb-6 tracking-tight uppercase">
                    Какво представлява СВЕТОВНА КАРТИНГ АРЕНА?
                </h2>
                <div class="bg-surface-container-low p-8 rounded-xl border-l-4 border-primary-container">
                    <p class="font-body text-on-surface-variant leading-relaxed">
                        СВЕТОВНА КАРТИНГ АРЕНА е онлайн
                        платформа, създадена специално за картинг състезатели и любители на моторните спортове.
                        Идеята ѝ е да обедини в едно място анализa на писти, рисуването на траектории, споделянето
                        на снимки и комуникацията между пилоти. Сайтът е създаден с мисията да помогне на
                        състезателите да се подготвят по-добре за нови писти, да подобрят техниката си на каране и
                        да обменят опит с други пилоти от различно ниво.
                    </p>
                </div>
            </section>
            <!-- Bento style features -->
            <div class="grid grid-cols-1 gap-12">
                <!-- Feature: Track Library -->
                <section class="group">
                    <div class="flex items-center gap-4 mb-6">
                        <span class="material-symbols-outlined text-primary-container text-4xl"
                              data-icon="alt_route"></span>
                        <h2 class="font-display text-2xl md:text-3xl font-bold text-primary-container tracking-tight uppercase">
                            Библиотека с писти и анализ на трасета
                        </h2>
                    </div>
                    <ul class="space-y-4 ml-2">
                        <li class="flex items-start gap-4">
                            <span class="text-primary-container font-black mt-1">›</span>
                            <p class="text-on-surface-variant leading-tight">
                                В платформата ще откриете богата
                                библиотека с картинг писти, всяка от които съдържа подробна информация, описание и
                                визуализация на трасето. Там потребителите могат:
                            </p>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="text-primary-container font-black mt-1">›</span>
                            <p class="text-on-surface-variant leading-tight">да разглеждат различни писти;</p>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="text-primary-container font-black mt-1">›</span>
                            <p class="text-on-surface-variant leading-tight">
                                да се запознаят с конфигурацията на
                                завоите;
                            </p>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="text-primary-container font-black mt-1">›</span>
                            <p class="text-on-surface-variant leading-tight">да анализират трудните участъци;</p>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="text-primary-container font-black mt-1">›</span>
                            <p class="text-on-surface-variant leading-tight">
                                да се подготвят предварително за
                                състезания на непознати трасета;
                            </p>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="text-primary-container font-black mt-1">›</span>
                            <p class="text-on-surface-variant leading-tight">
                                възможност за заявка на друга писта,
                                която не се състои в платформата; което дава сериозно предимство при подготовката и
                                изграждането на състезателна стратегия.
                            </p>
                        </li>
                    </ul>
                </section>
                <!-- Feature: Trajectories -->
                <section class="group">
                    <div class="flex items-center gap-4 mb-6">
                        <span class="material-symbols-outlined text-primary-container text-4xl"
                              data-icon="gesture"></span>
                        <h2 class="font-display text-2xl md:text-3xl font-bold text-primary-container tracking-tight uppercase">
                            Рисуване и споделяне на траектории
                        </h2>
                    </div>
                    <ul class="space-y-4 ml-2">
                        <li class="flex items-start gap-4">
                            <span class="text-primary-container font-black mt-1">›</span>
                            <p class="text-on-surface-variant leading-tight">
                                Една от най-иновативните функции на
                                СВЕТОВНА КАРТИНГ АРЕНА е възможността за рисуване на състезателни траектории
                                директно върху визуализация на пистата. Потребителите могат:
                            </p>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="text-primary-container font-black mt-1">›</span>
                            <p class="text-on-surface-variant leading-tight">
                                да създават свои собствени траектории;
                            </p>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="text-primary-container font-black mt-1">›</span>
                            <p class="text-on-surface-variant leading-tight">
                                да запазват и споделят своите линии с
                                различни цветове;
                            </p>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="text-primary-container font-black mt-1">›</span>
                            <p class="text-on-surface-variant leading-tight">
                                да разглеждат и харесват траектории,
                                създадени от други състезатели;
                            </p>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="text-primary-container font-black mt-1">›</span>
                            <p class="text-on-surface-variant leading-tight">
                                да сравняват различни стилове на
                                каране;
                            </p>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="text-primary-container font-black mt-1">›</span>
                            <p class="text-on-surface-variant leading-tight">
                                Това позволява по-дълбоко разбиране на
                                техниката, точките на спиране, апекса и изхода от завоите.
                            </p>
                        </li>
                    </ul>
                </section>
                <!-- Feature: Blog & Community -->
                <section class="group">
                    <div class="flex items-center gap-4 mb-6">
                        <span class="material-symbols-outlined text-primary-container text-4xl"
                              data-icon="forum"></span>
                        <h2 class="font-display text-2xl md:text-3xl font-bold text-primary-container tracking-tight uppercase">
                            Блог, общност и споделяне на снимки
                        </h2>
                    </div>
                    <ul class="space-y-4 ml-2">
                        <li class="flex items-start gap-4">
                            <span class="text-primary-container font-black mt-1">›</span>
                            <p class="text-on-surface-variant leading-tight">
                                Световната картинг арена не е просто
                                инструмент за анализ, а и общност. В платформата има:
                            </p>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="text-primary-container font-black mt-1">›</span>
                            <p class="text-on-surface-variant leading-tight">
                                блог секция с публикации, съвети и
                                анализи;
                            </p>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="text-primary-container font-black mt-1">›</span>
                            <p class="text-on-surface-variant leading-tight">
                                възможност за споделяне на снимки от
                                тренировки и състезания;
                            </p>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="text-primary-container font-black mt-1">›</span>
                            <p class="text-on-surface-variant leading-tight">
                                харесване на публикации на други
                                потребители;
                            </p>
                        </li>
                        <li class="flex items-start gap-4">
                            <span class="text-primary-container font-black mt-1">›</span>
                            <p class="text-on-surface-variant leading-tight">
                                По този начин състезателите могат да
                                обменят знания, да обсъждат стратегии и да се учат един от друг.
                            </p>
                        </li>
                    </ul>
                </section>
            </div>
            <!-- Contact Section -->
            <section class="mt-24 mb-12 p-12 rounded-2xl bg-surface-container-high relative overflow-hidden">
                <div class="absolute top-0 right-0 p-8 opacity-10 pointer-events-none">
                    <span class="material-symbols-outlined text-[160px]" data-icon="alternate_email"></span>
                </div>
                <div class="relative z-10">
                    <h2 class="font-display text-3xl font-black text-on-surface mb-4 uppercase tracking-tighter">
                        Контакти за връзка
                    </h2>
                    <p class="text-on-surface-variant mb-6 font-medium">
                        При технически проблем на платформата може
                        да ни пишете на нашият имейл за обратна връзка:
                    </p>
                    <a class="inline-flex items-center gap-3 text-2xl font-bold text-primary-container hover:text-primary transition-colors group"
                       href="mailto:worldkarting101@gmail.com">
                        worldkarting101@gmail.com<span class="material-symbols-outlined group-hover:translate-x-2 transition-transform"
                                                       data-icon="arrow_forward"></span>
                    </a>
                </div>
            </section>
        </div>
    </div>
</main>